# ── net-twin environment template ─────────────────────────
# Copy to .env and adjust. Never commit .env.

# --- Backend ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Data stores ---
DATABASE_URL=postgresql+asyncpg://nettwin:nettwin@localhost:5432/nettwin
REDIS_URL=redis://localhost:6379/0

# --- Discovery ---
# CIDR to sweep, e.g. 192.168.1.0/24
DISCOVERY_SUBNET=10.0.0.0/24
DISCOVERY_INTERVAL_SECONDS=300
# data source: live | simulator
DISCOVERY_SOURCE=simulator

# --- SNMP ---
SNMP_COMMUNITY=public
SNMP_TIMEOUT_SECONDS=2
SNMP_RETRIES=1

# --- Monitoring ---
MONITOR_INTERVAL_SECONDS=15
ALERT_LATENCY_THRESHOLD_MS=200
ALERT_PACKET_LOSS_THRESHOLD_PCT=10

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/events
